### =========================
### CROSS-USER ACCESS TESTS
### =========================

### Negative test: User cannot deposit to another user's account
### Expected result: 403 Forbidden

POST http://localhost:4111/api/v1/accounts/deposit
Content-Type: application/json
Authorization: Basic a2F0ZTE5OTg5OnZlcnlzVFJvbmdQYXNzd29yZDMzJDg=

{
  "id": 5,
  "balance": 100
}

### Positive test: User can transfer money to another user's account
### Expected result: 200 OK

POST http://localhost:4111/api/v1/accounts/transfer
Content-Type: application/json
Authorization: Basic a2F0ZTE5OTg5OnZlcnlzVFJvbmdQYXNzd29yZDMzJDg=

{
  "senderAccountId": 3,
  "receiverAccountId": 5,
  "amount": 100
}

### Negative test: User cannot transfer money from another user's account
### Expected result: 403 Forbidden

POST http://localhost:4111/api/v1/accounts/transfer
Content-Type: application/json
Authorization: Basic a2F0ZTE5OTg5OnZlcnlzVFJvbmdQYXNzd29yZDMzJDg=

{
  "senderAccountId": 5,
  "receiverAccountId": 3,
  "amount": 100
}


